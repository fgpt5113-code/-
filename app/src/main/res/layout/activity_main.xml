<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone UX Logger"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Открыть настройки спец. возможностей" />

        <CheckBox
            android:id="@+id/loggingEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Записывать события" />

        <CheckBox
            android:id="@+id/verboseEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Полный поток Accessibility-событий (больше данных и расхода)" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Обычный режим не перехватывает ввод. Для кликов X/Y — центр границ элемента, а не сырой физический контакт пальца. На Android 14+ доступен отдельный 10-секундный тест сырых координат; во время него касания не передаются приложениям."
            android:textSize="14sp" />

        <Button
            android:id="@+id/rawTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="10 секунд: сырые координаты (Android 14+)" />

        <Button
            android:id="@+id/exportCsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Экспорт CSV" />

        <Button
            android:id="@+id/exportJson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Экспорт JSON" />

        <Button
            android:id="@+id/clearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Очистить журнал" />

        <TextView
            android:id="@+id/stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Не записываются: введённый текст, содержимое уведомлений, пароли, снимки экрана и сеть. База хранится локально в приватном хранилище приложения."
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
